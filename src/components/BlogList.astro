---
import type { CollectionEntry } from 'astro:content';

interface Props {
  blogs: CollectionEntry<'blogs'>[];
}

const { blogs } = Astro.props;
const monthYear = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<ul class="divide-y divide-stone-300/80">
  {blogs.map((blog, i) => (
    <li data-reveal style={`--d:${Math.min(i, 4) * 70}ms`}>
      <a href={`/blogs/${blog.id}`} class="group block py-7">
        <span class="text-sm text-stone-500">{monthYear(blog.data.pubDate)}</span>
        <h3
          class="mt-1 text-2xl font-semibold leading-snug tracking-tight text-stone-900 transition group-hover:text-teal-700"
          transition:name={`blog-${blog.id}`}
        >
          <span class="link-wipe">{blog.data.title}</span>
        </h3>
        <p class="mt-2 text-base leading-relaxed text-stone-500">{blog.data.description}</p>
      </a>
    </li>
  ))}
</ul>
