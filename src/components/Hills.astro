---
// Line-drawn Himachal ridges with a rising sun; draws itself on load.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 400 120" class:list={['hills text-stone-400', className]} aria-hidden="true">
  <circle class="hills-sun" cx="300" cy="46" r="14" fill="#f59e0b" opacity="0.85"></circle>
  <path
    pathLength="1"
    d="M0 110 L50 70 L80 86 L140 30 L190 78 L230 56 L280 96"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"></path>
  <path
    pathLength="1"
    d="M120 110 L200 64 L240 80 L310 40 L360 76 L400 60"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
    style="--delay: 0.5s"></path>
  <path pathLength="1" d="M0 116 L400 116" fill="none" stroke="currentColor" stroke-width="1" style="--delay: 1s"
  ></path>
</svg>

<style>
  .hills path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hills-draw 2.6s cubic-bezier(0.6, 0, 0.2, 1) forwards;
    animation-delay: calc(0.5s + var(--delay, 0s));
  }
  @keyframes hills-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .hills-sun {
    opacity: 0;
    translate: 0 60px;
    animation: hills-rise 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) 1.6s forwards;
  }
  @keyframes hills-rise {
    to {
      opacity: 0.85;
      translate: 0 0;
    }
  }
</style>
